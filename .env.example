# GlobalOrbitUSA — placeholders only. Copy to a server-local .env (never commit).
# This project must NOT use HostingBeyond DATABASE_URL, roles, or data directories.

NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1

# PostgreSQL — dedicated GlobalOrbitUSA database and role only.
# Expected database: globalorbitusa_db
# Expected role:     globalorbitusa_app
# Host must be local. Do not point this at hostingbeyond_db or hostingbeyond_user.
DATABASE_URL="postgresql://globalorbitusa_app:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/globalorbitusa_db?schema=public"

# Uploads live outside the Git repository.
UPLOAD_DIR=/data/globalorbitusa/uploads

# Public canonical origin (no trailing slash). Used for sitemap, robots, OG, JSON-LD.
# Production: https://globalorbit.us (required on the live server; rebuild after change)
# Local dev:  http://127.0.0.1:3001 or omit (code fallback is apex)
NEXT_PUBLIC_SITE_URL=https://globalorbit.us

# Orbit /admin dashboard (server .env only — never commit the real value).
ORBIT_EDITOR_USERNAME=
ORBIT_EDITOR_PASSWORD=
